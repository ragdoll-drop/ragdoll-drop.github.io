---
/**
 * BaseLayout — document shell, metadata and structured data hooks.
 *
 * Every URL in the head is absolute and includes the deployment base path, so
 * the same build works on a GitHub Pages project page or on a custom domain.
 */
import '../styles/global.css';
import '@fontsource-variable/inter';

import { SITE, SITE_ORIGIN, absolute, absoluteAsset } from '../config/site';
import { getLangFromUrl, alternatesFor, hreflangCode } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Page path relative to the site root, e.g. `/about/`. */
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  image = '/og-cover.jpg',
  canonicalPath,
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const canonical = canonicalPath
  ? new URL(absolute(canonicalPath)).toString()
  : Astro.url.origin + Astro.url.pathname;
const ogImage = absoluteAsset(image);
const htmlLang = lang;
const alternates = alternatesFor(Astro.url).map((alt) => ({
  ...alt,
  url: new URL(alt.href, SITE_ORIGIN).toString(),
}));
const defaultAlt = alternates.find((alt) => alt.lang === 'en') ?? alternates[0];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="PNesw5T_utEAZhLvAaPvsuCaw372g19p6LucyzQetlI" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={SITE.themeColor} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={hreflangCode(alt.lang)} href={alt.url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultAlt.url} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href={absoluteAsset('/favicon.svg')} />
    <link rel="apple-touch-icon" href={absoluteAsset('/apple-touch-icon.png')} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta property="og:locale" content={SITE.locale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-[var(--accent)] focus:px-4 focus:py-2 focus:font-semibold focus:text-black"
    >
      Skip to content
    </a>

    <slot name="header" />

    <main id="main-content">
      <slot />
    </main>

    <slot name="footer" />

    <!-- Cloudflare Web Analytics -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "7cb1be994d904290895ed77cb97891ef"}'
    ></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
