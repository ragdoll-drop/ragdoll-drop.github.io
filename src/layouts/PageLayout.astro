---
/**
 * PageLayout — shared frame for every long-form article page.
 *
 * Renders breadcrumbs, a sticky table of contents, the prose sections, the FAQ
 * block and the related-links block, and emits HowTo/Article structured data
 * from the very same content objects.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import FaqAccordion from '../components/ui/FaqAccordion.astro';
import Steps from '../components/ui/Steps.astro';
import DataTable from '../components/ui/DataTable.astro';

import type { PageContent } from '../data/pages';
import { pages } from '../data/pages';
import { SITE, SITE_ORIGIN, absolute, absoluteAsset } from '../config/site';
import { getLangFromUrl, useTranslations, localizedHref } from '../i18n/utils';
import { inlineToHtml } from '../lib/inline';

interface Props {
  page: PageContent;
}

const { page } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const canonicalPath = `/${page.slug}/`;
const homeHref = localizedHref(lang, '/');

const related = (page.related ?? [])
  .map((slug) => pages[lang].find((candidate) => candidate.slug === slug))
  .filter((candidate): candidate is PageContent => Boolean(candidate));

const stepsSections = page.sections.filter((section) => section.steps?.length);

const schema: Record<string, unknown>[] = [];

if (page.schema === 'HowTo' && stepsSections.length) {
  schema.push({
    '@type': 'HowTo',
    name: page.heading,
    description: page.description,
    inLanguage: 'en-US',
    step: stepsSections.flatMap((section) =>
      (section.steps ?? []).map((step) => ({
        '@type': 'HowToStep',
        name: step.title,
        text: step.text,
      }))
    ),
  });
} else {
  schema.push({
    '@type': 'Article',
    headline: page.heading,
    description: page.description,
    inLanguage: 'en-US',
    mainEntityOfPage: absolute(canonicalPath),
    datePublished: page.updated,
    dateModified: page.updated,
    image: absoluteAsset('/og-cover.jpg'),
    author: { '@type': 'Organization', name: SITE.name, url: SITE_ORIGIN },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      logo: { '@type': 'ImageObject', url: absoluteAsset('/favicon.svg') },
    },
  });
}
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonicalPath={canonicalPath}
  ogType="article"
  modifiedTime={page.updated}
>
  <Fragment slot="head">
    <JsonLd schema={schema} />
  </Fragment>

  <Header slot="header" />

  <div class="mx-auto max-w-6xl px-4 pt-8 md:px-6">
    <Breadcrumbs
      items={[
        { label: t('common.home'), href: homeHref },
        { label: page.heading },
      ]}
    />

    <div class="mt-8 grid gap-12 lg:grid-cols-[220px_minmax(0,1fr)]">
      <!-- Table of contents -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <p class="text-xs font-semibold tracking-wider text-[var(--text-tertiary)] uppercase">
            {t('common.onThisPage')}
          </p>
          <ul class="mt-3 space-y-1.5 border-l border-[var(--border)] pl-3">
            {page.sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="block text-[0.8rem] leading-snug text-[var(--text-tertiary)] transition-colors hover:text-[var(--text-primary)]"
                >
                  {section.heading}
                </a>
              </li>
            ))}
          </ul>
          <a
            href={homeHref}
            class="mt-6 inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--color-primary-300)] hover:text-[var(--color-primary-200)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              class="h-3.5 w-3.5"
              aria-hidden="true"
            >
              <path d="M15 18l-6-6 6-6" />
            </svg>
            {t('common.backToGame')}
          </a>
        </div>
      </aside>

      <article>
        <header>
          <p class="text-xs font-semibold tracking-wider text-[var(--color-primary-400)] uppercase">
            Ragdoll Drop Online
          </p>
          <h1
            class="mt-2 font-display text-3xl font-bold tracking-tight text-[var(--text-primary)] sm:text-4xl"
          >
            {page.heading}
          </h1>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-[var(--text-secondary)]">
            {page.intro}
          </p>
          <p class="mt-3 text-xs text-[var(--text-tertiary)]">
            {t('common.updated')}: <time datetime={page.updated}>{page.updated}</time>
          </p>
        </header>

        <div class="prose mt-10">
          {page.sections.map((section) => (
            <section class="mb-10">
              <h2 id={section.id} class="text-2xl font-bold">
                {section.heading}
              </h2>

              {section.body?.map((paragraph) => (
                <p set:html={inlineToHtml(paragraph)} />
              ))}

              {section.steps && <Steps steps={section.steps} />}

              {section.bullets && (
                <ul>
                  {section.bullets.map((bullet) => (
                    <li set:html={inlineToHtml(bullet)} />
                  ))}
                </ul>
              )}

              {section.table && (
                <DataTable
                  head={section.table.head}
                  rows={section.table.rows}
                  caption={section.table.caption}
                />
              )}
            </section>
          ))}
        </div>

        {page.faqs && <FaqAccordion items={page.faqs} title={t('common.faqTitle')} />}

        <!-- Back to the game -->
        <div
          class="not-prose mt-12 flex flex-col items-start justify-between gap-4 rounded-2xl border border-[var(--color-primary-700)]/60 bg-[var(--color-primary-950)]/40 p-6 sm:flex-row sm:items-center"
        >
          <div>
            <p class="font-display text-lg font-bold text-[var(--text-primary)]">
              Ready to break something?
            </p>
            <p class="mt-1 text-sm text-[var(--text-secondary)]">
              The full game loads in your browser — no account, no download.
            </p>
          </div>
          <a href={homeHref} class="btn-primary shrink-0"> {t('cta.playNow')} </a>
        </div>

        <!-- Related pages -->
        {related.length > 0 && (
          <section class="not-prose mt-12">
            <h2 class="text-sm font-semibold tracking-wider text-[var(--text-tertiary)] uppercase">
              {t('common.relatedPages')}
            </h2>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {related.map((item) => (
                <a
                  href={localizedHref(lang, `/${item.slug}/`)}
                  class="card group p-4 transition-colors hover:border-[var(--border-hover)]"
                >
                  <p class="text-sm font-semibold text-[var(--text-primary)] group-hover:text-[var(--color-primary-300)]">
                    {item.heading}
                  </p>
                  <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-[var(--text-secondary)]">
                    {item.description}
                  </p>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
