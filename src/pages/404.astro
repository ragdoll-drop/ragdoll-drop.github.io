---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { localizedHref } from '../i18n/utils';
import { SITE } from '../config/site';

const quickLinks = [
  { label: 'How to Play', path: '/how-to-play/' },
  { label: 'Controls', path: '/controls/' },
  { label: 'Tips & Tricks', path: '/tips/' },
  { label: 'Unblocked', path: '/unblocked/' },
];
---

<BaseLayout
  title={`404 — Page not found | ${SITE.name}`}
  description="That page does not exist. Head back to the game and keep launching the ragdoll."
  canonicalPath="/404/"
  noindex={true}
>
  <Header slot="header" />

  <div class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center md:px-6">
    <p class="font-display text-7xl font-bold text-[var(--color-primary-700)]">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold text-[var(--text-primary)]">
      Page not found
    </h1>
    <p class="mt-3 max-w-md text-base leading-relaxed text-[var(--text-secondary)]">
      That page does not exist — but the ragdoll is still one click away. Head back to the game.
    </p>

    <a href={localizedHref('en', '/')} class="btn-primary mt-8">Play Ragdoll Drop</a>

    <nav class="mt-10 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
      {quickLinks.map((link) => (
        <a
          href={localizedHref('en', link.path)}
          class="text-[var(--text-tertiary)] transition-colors hover:text-[var(--text-primary)]"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>

  <Footer slot="footer" />
</BaseLayout>
