---
/**
 * JsonLd.astro — renders one or more Schema.org objects as JSON-LD.
 *
 * Kept intentionally generic: the page decides which @type and which
 * properties to emit, so adding a new schema type never requires touching this
 * component.
 *
 * Usage:
 *   <JsonLd schema={{ '@context': 'https://schema.org', '@type': 'WebSite', … }} />
 *   <JsonLd schema={[schemaA, schemaB]} />
 */
interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[];
}

const { schema } = Astro.props;
const payload = Array.isArray(schema) ? schema : [schema];
---

{
  payload.map((item) => (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({ '@context': 'https://schema.org', ...item })}
    />
  ))
}
