---
/**
 * Home — the playable page. Game first, then the content that explains what
 * the game is, how it works and how to get better at it.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import GameEmbed from '../game/GameEmbed.astro';
import FaqAccordion from '../ui/FaqAccordion.astro';
import Steps from '../ui/Steps.astro';
import DataTable from '../ui/DataTable.astro';
import FeatureGrid from '../ui/FeatureGrid.astro';
import JsonLd from '../seo/JsonLd.astro';

import { home, pages } from '../../data/pages';
import {
  SITE,
  absolute,
  absoluteAsset,
  GAME_OFFICIAL_URL,
  GAME_DEVELOPER_URL,
} from '../../config/site';
import { useTranslations, localizedHref, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const content = home[lang];

const canonicalPath = '/';
const guides = pages[lang].filter((page) =>
  ['how-to-play', 'controls', 'tips', 'unblocked'].includes(page.slug)
);

const controlRows = [
  ['Round button', 'Hold to launch'],
  ['Same button', 'Tap to jump'],
  ['⏸', 'Pause'],
  ['↻', 'Restart level'],
  ['Left column', 'Shop: vehicles and props'],
  ['УРОВНИ', 'Level select'],
  ['ОБЪЕКТЫ', 'Object collection'],
];

const schema = [
  {
    '@type': 'VideoGame',
    name: 'Ragdoll Drop',
    url: absolute(canonicalPath),
    description: SITE.description,
    image: absoluteAsset('/og-cover.jpg'),
    applicationCategory: 'Game',
    gamePlatform: ['Web browser', 'Android', 'iOS'],
    genre: [...SITE.genres],
    operatingSystem: 'Any (browser-based)',
    playMode: ['SinglePlayer'],
    contentRating: SITE.ageRating,
    inLanguage: 'en-US',
    author: { '@type': 'Organization', name: SITE.author, url: GAME_DEVELOPER_URL },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
  },
  {
    '@type': 'WebSite',
    name: SITE.name,
    url: absolute(canonicalPath),
    description: SITE.description,
    inLanguage: 'en-US',
  },
];
---

<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={content.description}
  canonicalPath={canonicalPath}
>
  <Fragment slot="head">
    <JsonLd schema={schema} />
  </Fragment>

  <Header slot="header" />

  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <!-- Game first: the player sits directly under the header so a visitor can
         start causing trouble without scrolling or reading anything. -->
    <section class="pt-4 pb-4 md:pt-6">
      <div class="mx-auto max-w-5xl">
        <GameEmbed />
      </div>

      <div class="mx-auto mt-8 max-w-3xl text-center">
        <h1
          class="font-display text-3xl font-bold tracking-tight text-[var(--text-primary)] sm:text-4xl md:text-5xl"
        >
          {content.heading}
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-[var(--text-secondary)]">
          {content.intro}
        </p>
      </div>

      <div
        class="mx-auto mt-6 flex max-w-5xl flex-wrap items-center justify-center gap-2 text-xs text-[var(--text-tertiary)]"
      >
        <span class="chip">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent-500)]"></span>
          Browser build · {SITE.gameUpdated}
        </span>
        <span class="chip">Free to play</span>
        <span class="chip">No download</span>
        <span class="chip">No account</span>
        <span class="chip">Touch controls</span>
        <span class="chip">{SITE.ageRating}</span>
      </div>
    </section>

    <!-- What is Ragdoll Drop -->
    <section class="mt-16">
      <div class="prose mx-auto max-w-3xl">
        <h2 class="font-display text-2xl font-bold text-[var(--text-primary)] sm:text-3xl">
          {content.aboutHeading}
        </h2>
        {content.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <!-- Features -->
    <section class="mt-14">
      <h2 class="font-display text-2xl font-bold tracking-tight text-[var(--text-primary)] sm:text-3xl">
        {content.featuresHeading}
      </h2>
      <FeatureGrid items={content.features} />
    </section>

    <!-- How to start -->
    <section class="mt-14 grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div>
        <h2 class="font-display text-2xl font-bold tracking-tight text-[var(--text-primary)] sm:text-3xl">
          {content.stepsHeading}
        </h2>
        <Steps steps={content.steps} />
        <a
          href={localizedHref(lang, '/how-to-play/')}
          class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-primary-300)] hover:text-[var(--color-primary-200)]"
        >
          {t('common.readGuide')}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <div>
        <h2 class="font-display text-2xl font-bold tracking-tight text-[var(--text-primary)] sm:text-3xl">
          {content.controlsHeading}
        </h2>
        <DataTable head={['Control', 'What it does']} rows={controlRows} />
        <p class="mt-3 text-sm text-[var(--text-secondary)]">
          {content.controlsNote}
          <a
            href={localizedHref(lang, '/controls/')}
            class="ml-1 font-semibold text-[var(--color-primary-300)] hover:text-[var(--color-primary-200)]"
          >
            {t('nav.controls')}
          </a>
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <FaqAccordion items={content.faqs} title={t('common.faqTitle')} />

    <!-- Guides -->
    <section class="mt-16">
      <h2 class="font-display text-2xl font-bold tracking-tight text-[var(--text-primary)] sm:text-3xl">
        Ragdoll Drop guides
      </h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {guides.map((guide) => (
          <a
            href={localizedHref(lang, `/${guide.slug}/`)}
            class="card group flex flex-col p-5 transition-colors hover:border-[var(--border-hover)]"
          >
            <h3 class="font-display text-base font-bold text-[var(--text-primary)] group-hover:text-[var(--color-primary-300)]">
              {guide.heading}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
              {guide.description}
            </p>
          </a>
        ))}
      </div>

      <p class="mt-6 text-sm text-[var(--text-secondary)]">
        Want the developer’s own page, reviews and updates? The official listing is
        <a
          href={GAME_OFFICIAL_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-1 font-semibold text-[var(--color-primary-300)] hover:text-[var(--color-primary-200)]"
        >
          here
        </a>.
      </p>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
